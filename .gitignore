# Project-specific ignores

# Keep lib directory but ignore JAR files (except necessary ones)
# Uncomment if you want to track external JARs:
# !lib/javax.mail.jar
# !lib/itextpdf-*.jar

# Ignore generated data files (keep structure, ignore content)
data/*.txt
data/*.dat
!data/.gitkeep

# Ignore generated PDF reports
reports/*.pdf
!reports/.gitkeep

# Ignore generated documentation screenshots
docs/Screenshots/*
!docs/Screenshots/.gitkeep

# Keep docs directory structure
!docs/.gitkeep
